process {
    cpus   = 1
    memory = 2.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withName: 'FASTQC|TRIM_GALORE' {
        cpus   = 2
        memory = 4.GB
    }

    withName: 'STAR_INDEX|STAR_ALIGN' {
        cpus   = 4
        memory = 8.GB
    }

    withName: 'COUNT_MATRIX|DESEQ2|ENRICHMENT|MULTIQC' {
        cpus   = 1
        memory = 2.GB
    }
}
